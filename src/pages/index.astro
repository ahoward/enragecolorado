---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('assessments'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = all.slice(0, 4);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base>
  <section class="hero">
    <p class="eyebrow">A standing record · Colorado · updated by the public</p>
    <h1 class="display headline">
      They called it an <span class="strike">honest assessment</span>.<br />
      We are keeping the <span class="hot">honest</span> part.
    </h1>
    <p class="lede">
      When the venture class writes the story of an election, the story ends at their own comfort.
      This is the other ledger — a public monument to what techno-authoritarian politics actually
      costs the people who live here, and a refusal to let a glossy post-mortem stand as the last word.
    </p>
    <div class="cta">
      <a class="btn" href="/assessments">Read the record</a>
      <a class="btn ghost" href="/about">Why this exists</a>
    </div>
  </section>

  <section class="thesis">
    <hr />
    <div class="grid3">
      <div>
        <h3 class="display">Not a mirror of their words</h3>
        <p class="dim">We do not reprint their copy. We answer it. Original commentary, in the open, with our name on it — the collective one.</p>
      </div>
      <div>
        <h3 class="display">A monument, not a hot take</h3>
        <p class="dim">Built to be added to for years. Every entry is a file. The record only grows, and the public holds the pen.</p>
      </div>
      <div>
        <h3 class="display">The public's perspective</h3>
        <p class="dim">Not the donor's, not the fund's, not the think-tank's. The people who have to live in the Colorado these decisions build.</p>
      </div>
    </div>
  </section>

  <section class="latest">
    <hr />
    <div class="sec-head">
      <h2 class="display">The Record</h2>
      <a class="mono more" href="/assessments">all entries →</a>
    </div>
    {latest.length === 0 ? (
      <p class="dim">The first entry is being carved. Add one: open a pull request with a markdown file in <code>src/content/assessments/</code>.</p>
    ) : (
      <ul class="entries">
        {latest.map((e) => (
          <li>
            <a href={`/assessments/${e.id}`}>
              <time class="mono dim" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
              <span class="display t">{e.data.title}</span>
              <span class="dim s">{e.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .hero { padding-top: clamp(2rem, 7vw, 4.5rem); }
  .headline { font-size: clamp(2.3rem, 7vw, 4.4rem); font-weight: 900; margin: 0.6rem 0 1.2rem; text-wrap: balance; }
  .strike { text-decoration: line-through; text-decoration-color: var(--alarm); text-decoration-thickness: 4px; color: var(--ink-dim); }
  .hot { color: var(--alarm); }
  .lede { font-size: clamp(1.15rem, 2.4vw, 1.4rem); max-width: 60ch; color: var(--ink); }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .btn { font-family: 'Archivo', system-ui, sans-serif; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.03em; font-size: 0.85rem; text-decoration: none; padding: 0.7rem 1.2rem; border-radius: 7px;
    background: var(--alarm); color: #fff; border: 2px solid var(--alarm); }
  .btn.ghost { background: transparent; color: var(--ink); border-color: var(--rule); }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .grid3 h3 { margin: 0 0 0.4rem; font-size: 1.1rem; }
  .grid3 p { margin: 0; font-size: 0.98rem; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .sec-head h2 { margin: 0; font-size: 1.5rem; }
  .more { font-size: 0.78rem; text-decoration: none; color: var(--alarm); }
  .entries { list-style: none; padding: 0; margin: 1.4rem 0 0; }
  .entries li { border-top: 1px solid var(--rule); }
  .entries li:last-child { border-bottom: 1px solid var(--rule); }
  .entries a { display: grid; grid-template-columns: 9rem 1fr; gap: 0.2rem 1.2rem; padding: 1.1rem 0;
    text-decoration: none; color: var(--ink); align-items: baseline; }
  .entries time { grid-row: 1 / span 2; font-size: 0.8rem; }
  .entries .t { font-size: 1.2rem; font-weight: 800; }
  .entries .s { font-size: 0.95rem; }
  .entries a:hover .t { color: var(--alarm); }
  @media (max-width: 680px) {
    .grid3 { grid-template-columns: 1fr; gap: 1.2rem; }
    .entries a { grid-template-columns: 1fr; }
    .entries time { grid-row: auto; }
  }
</style>
