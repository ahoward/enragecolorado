---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('assessments');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="prose entry">
    <p class="eyebrow">An entry on the record</p>
    <h1 class="display headline">{entry.data.title}</h1>
    <p class="meta mono dim">
      <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
      · signed <span class="sig">{entry.data.author}</span>
    </p>
    <p class="summary">{entry.data.summary}</p>
    <div class="tags">{entry.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <hr />
    <Content />
    <hr />
    <p class="dim foot">
      Disagree with this entry? Good — that is how a public record stays honest. Open a pull request or an
      issue at <a href="https://github.com/ahoward/enragecolorado">github.com/ahoward/enragecolorado</a>.
      This entry is commentary and opinion, not a statement of fact about any identifiable private individual.
    </p>
    <p><a href="/assessments">← back to the record</a></p>
  </article>
</Base>

<style>
  .entry { padding-top: 1.5rem; }
  .headline { font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 900; margin: 0.4rem 0 0.8rem; text-wrap: balance; }
  .meta { font-size: 0.78rem; margin: 0 0 1.2rem; }
  .sig { color: var(--alarm); }
  .summary { font-size: 1.25rem; color: var(--ink); max-width: 62ch; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.8rem; }
  .foot { font-size: 0.86rem; }
</style>
