{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "enragecolorado",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist"
	},
	"routes": [
		{ "pattern": "enragecolorado.org", "custom_domain": true },
		{ "pattern": "www.enragecolorado.org", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
